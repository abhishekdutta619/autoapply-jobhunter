# Postgres connection string.
# Local dev without Postgres installed? Leave unset and the app falls back
# to a local SQLite file (job_hunter.db) so you can still run everything.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/job_hunter

# Comma-separated company slugs per source. The slug is whatever appears
# in that company's public job board URL for that ATS, e.g.:
#   Greenhouse: boards.greenhouse.io/{slug}
#   Lever:      jobs.lever.co/{slug}
#   Ashby:      jobs.ashbyhq.com/{slug}
GREENHOUSE_COMPANIES=stripe,pinterest,doordash
LEVER_COMPANIES=netflix,reddit
ASHBY_COMPANIES=ashby,notion

# Workday needs three pieces per company, not one slug like the sources
# above: 'tenant|wd_host|site'. Find these by opening the company's real
# careers page and reading them off the URL:
#   https://{tenant}.{wd_host}.myworkdayjobs.com/{site}
# Example: https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite
#       -> tenant=nvidia, wd_host=wd5, site=NVIDIAExternalCareerSite
WORKDAY_COMPANIES=nvidia|wd5|NVIDIAExternalCareerSite

# Fetching full descriptions costs one extra request PER JOB (Workday's
# list endpoint doesn't include them). Set false for a fast listing-only
# pass; the Evaluator will just see less to score against.
WORKDAY_FETCH_DESCRIPTIONS=true
WORKDAY_DETAIL_DELAY_SECONDS=0.5

# Polling courtesy: minimum seconds to wait between requests to the same
# source. None of these APIs publish a hard rate limit, but hammering them
# can get your IP soft-blocked. Keep this conservative.
REQUEST_DELAY_SECONDS=1.5

# --- Evaluator (Phase 2) ---
# Which provider scores your resume against each job: "anthropic" or "openai"
LLM_PROVIDER=anthropic

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Copy resume.md.example -> resume.md and fill in your real resume first.
RESUME_PATH=resume.md

# Jobs scoring ABOVE this get marked APPROVED_FOR_APPLY; at/below get TRASHED.
APPROVAL_THRESHOLD=85

EVAL_REQUEST_DELAY_SECONDS=1.0

# --- Executor (Phase 3) ---
# Copy candidate_profile.json.example -> candidate_profile.json and fill it
# in. resume_file_path inside it must point to an actual PDF/DOCX to upload
# - separate from resume.md above, which is plain text used only for
# LLM scoring.
CANDIDATE_PROFILE_PATH=candidate_profile.json

# Headed (visible) by default on purpose - you should be watching and
# physically present to review and click submit, not running this
# unattended. Leave false unless you have a specific reason to change it.
EXECUTOR_HEADLESS=false

# Optional: RAG-drafted answers for cover letters / open-ended questions.
# Copy story_bank.json.example -> story_bank.json and add real stories.
# Without this file, the Executor just skips those fields for you to
# write yourself - nothing breaks if you never set this up.
STORY_BANK_PATH=story_bank.json

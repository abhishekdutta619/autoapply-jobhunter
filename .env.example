# Postgres connection string.
# Local dev without Postgres installed? Leave this line commented out and
# the app falls back to a local SQLite file (job_hunter.db) - zero extra
# setup needed. Only uncomment once you have a real Postgres instance
# running (see README's Postgres troubleshooting section for options).
# DATABASE_URL=postgresql+psycopg2://user:password@127.0.0.1:5432/job_hunter

# Comma-separated company slugs per source. The slug is whatever appears
# in that company's public job board URL for that ATS, e.g.:
#   Greenhouse: boards.greenhouse.io/{slug}
#   Lever:      jobs.lever.co/{slug}
#   Ashby:      jobs.ashbyhq.com/{slug}
GREENHOUSE_COMPANIES=stripe,pinterest,doordashusa
# Tip: a company's slug isn't always their name - e.g. DoorDash's token is
# "doordashusa", not "doordash". Verify by opening
# boards.greenhouse.io/{slug} yourself before trusting any example list,
# including this one.
LEVER_COMPANIES=lever
# Real-world note: many well-known companies have since moved off Lever
# entirely (Netflix, for one) even if older guides still list them. If a
# slug 404s, check https://jobs.lever.co/{slug} directly in a browser
# before assuming it's a typo.
ASHBY_COMPANIES=ashby,notion

# Workday needs three pieces per company, not one slug like the sources
# above: 'tenant|wd_host|site'. Find these by opening the company's real
# careers page and reading them off the URL:
#   https://{tenant}.{wd_host}.myworkdayjobs.com/{site}
# Example: https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite
#       -> tenant=nvidia, wd_host=wd5, site=NVIDIAExternalCareerSite
WORKDAY_COMPANIES=nvidia|wd5|NVIDIAExternalCareerSite

# Fetching full descriptions costs one extra request PER JOB (Workday's
# list endpoint doesn't include them). Set false for a fast listing-only
# pass; the Evaluator will just see less to score against.
WORKDAY_FETCH_DESCRIPTIONS=true
WORKDAY_DETAIL_DELAY_SECONDS=0.5

# Polling courtesy: minimum seconds to wait between requests to the same
# source. None of these APIs publish a hard rate limit, but hammering them
# can get your IP soft-blocked. Keep this conservative.
REQUEST_DELAY_SECONDS=1.5

# --- Evaluator (Phase 2) ---
# Which provider scores your resume against each job: "anthropic", "openai",
# "ollama" (free, local, no API key), "gemini" (free tier, rate-limited -
# check https://ai.dev/rate-limit for YOUR project's actual daily quota,
# it varies a lot by model and isn't reliably documented anywhere else),
# or "hybrid" (see below - runs local first, only escalates ambiguous
# scores to a rate-limited cloud provider, so a low daily quota goes a
# lot further).
LLM_PROVIDER=ollama

# Only used when LLM_PROVIDER=hybrid. Every job gets scored by
# hybrid_local_provider first (should be something free/unlimited, i.e.
# ollama). Only jobs whose local score lands between REVIEW_THRESHOLD and
# APPROVAL_THRESHOLD (the same "ambiguous" band the review queue already
# uses) get a second opinion from hybrid_cloud_provider - clear
# rejects/matches never touch the cloud model at all, so a tight daily
# quota (e.g. 20 requests/day on a new preview model) can still cover a
# large queue, since most jobs won't be ambiguous.
HYBRID_LOCAL_PROVIDER=ollama
HYBRID_CLOUD_PROVIDER=gemini

# --- Cloud providers (cost money per request) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Free tier - Flash-family models, no credit card, no subscription needed.
# Get a key at https://aistudio.google.com/apikey (NOT the same thing as a
# paid consumer "Gemini Pro"/Google AI Pro subscription - that's a chat
# app subscription and doesn't grant this on its own).
#
# Model IDs and rate limits both shift over time - gemini-2.5-flash 404'd
# ("no longer available to new users") within days of being documented as
# stable elsewhere. If GEMINI_MODEL below starts 404ing, check
# https://ai.dev/rate-limit for your project's currently available models
# rather than trusting any specific name (including this one) to stay
# valid indefinitely.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- Local provider via Ollama (free, private, no API key) ---
# 1. Install Ollama: https://ollama.com/download
# 2. Pull a model once:  ollama pull llama3.1:8b
# 3. Ollama runs as a background service automatically after install -
#    check for its tray icon, or run `ollama list` to confirm it's up.
# Slower than a cloud provider (especially CPU-only, no dedicated GPU) and
# answer quality is a step down from GPT-4o/Claude for an 8B model - see
# README's "Local LLM (Ollama)" section for hardware-based model picks.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Copy resume.md.example -> resume.md and fill in your real resume first.
RESUME_PATH=resume.md

# Jobs scoring ABOVE this get marked APPROVED_FOR_APPLY; at/below get TRASHED.
APPROVAL_THRESHOLD=85

# Minimum seconds between Evaluator requests to the LLM. For local Ollama
# this is mostly just politeness. For Gemini's free tier, it matters a lot
# more - a real run measured exactly 5 requests/minute for gemini-3.7-flash
# on one project (published numbers online range from 5-30 RPM depending
# on source/date and aren't reliable - check https://ai.dev/rate-limit for
# your actual project's live limit). At 5 RPM, anything faster than ~12s
# between requests will hit 429s regularly - the client now retries those
# automatically with backoff, but a delay in the right ballpark means
# fewer wasted retry cycles. If you're on Gemini free tier, consider
# raising this to 12-15 rather than leaving the default below.
EVAL_REQUEST_DELAY_SECONDS=1.0

# Optional preferences, folded into the resume text the Evaluator sends
# the LLM. Both are off/unset by default - skill fit only. These are
# genuine soft preferences, not hard filters - no job gets excluded from
# scoring, and skill fit stays the dominant factor either way.
#
# PREFER_REMOTE=true tells the LLM remote is the first choice and
# onsite/hybrid is a real second choice - a modest score nudge, not a
# rejection. Silence on work arrangement in a posting isn't penalized.
PREFER_REMOTE=false
#
# Two separate targets, not one - the LLM judges from the company
# name/description whether a posting is an Indian company or a
# multinational, and compares against the matching target. Freeform on
# purpose - compensation bands vary by currency/market. Only penalizes
# when a posting explicitly states a range clearly below the applicable
# target; silence isn't penalized.
# TARGET_COMPENSATION_INDIAN=15-20 LPA
# TARGET_COMPENSATION_MNC=30-40 LPA in India, or globally-equivalent for remote roles

# --- Executor (Phase 3) ---
# Copy candidate_profile.json.example -> candidate_profile.json and fill it
# in. resume_file_path inside it must point to an actual PDF/DOCX to upload
# - separate from resume.md above, which is plain text used only for
# LLM scoring.
CANDIDATE_PROFILE_PATH=candidate_profile.json

# Headed (visible) by default on purpose - you should be watching and
# physically present to review and click submit, not running this
# unattended. Leave false unless you have a specific reason to change it.
EXECUTOR_HEADLESS=false

# Optional: RAG-drafted answers for cover letters / open-ended questions.
# Copy story_bank.json.example -> story_bank.json and add real stories.
# Without this file, the Executor just skips those fields for you to
# write yourself - nothing breaks if you never set this up.
STORY_BANK_PATH=story_bank.json